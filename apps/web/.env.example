# The base URL of your Go REST API
NEXT_PUBLIC_API_URL=http://localhost:8080

# Secret protecting POST /api/revalidate (cache invalidation).
# The built-in sync layer uses it internally; if you also register a webhook
# in the CMS, give it the same secret (HMAC X-Ndz-Signature is verified).
WEBHOOK_SECRET=change-me

# Live sync: the Next.js server subscribes to the Go API event stream and
# refreshes its content cache + connected browsers on every CMS change.
# Set to "false" to disable (e.g. static previews).
# LIVE_SYNC=true
# LIVE_SYNC_SELF_URL=http://127.0.0.1:3000

# Comma separated list of allowed dev origins for cross-origin requests
# ALLOWED_DEV_ORIGINS=your.dev.url

# Public contact email displayed on the website
NEXT_PUBLIC_CONTACT_EMAIL=your@email.com

# PostHog Analytics
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_key
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
